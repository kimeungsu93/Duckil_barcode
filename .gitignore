# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright MCP 산출물
/.playwright-mcp/

# 런타임 데이터 (DB·사진)
/data/

# scripts/backup-data.ts 기본 백업 위치 (DATA_DIR=./data일 때 저장소 루트의 backups/)
/backups/

# dev:https 자체 서명 인증서 (next dev --experimental-https)
/certificates/

# zxing-wasm 디코더 바이너리 (scripts/copy-zxing-wasm.mjs가 node_modules에서 복사)
/public/wasm/
